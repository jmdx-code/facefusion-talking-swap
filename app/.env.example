# FaceFusion Portable Studio - 环境变量配置示例（如需使用可复制为 .env，切勿提交真实密钥）

# Web UI 监听地址（默认严格绑定本机回环 127.0.0.1）
FACEFUSION_SERVER_NAME=127.0.0.1

# 可选：为 Gradio Web UI 开启 HTTP 登录鉴权
FACEFUSION_UI_USERNAME=
FACEFUSION_UI_PASSWORD=

# 可选：自定义 AI 模型缓存目录（留空默认使用 userdata/models）
FACEFUSION_MODELS_DIR=

# 可选：HTTP/HTTPS 网络代理（留空时自动读取系统代理设置）
HTTP_PROXY=
HTTPS_PROXY=
